# Server Environment & Port
NODE_ENV=development
PORT=5000

# Allowed CORS Origins (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173,https://anji0522.github.io

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/socialconnect

# Authentication Secrets
JWT_SECRET=dev-socialconnect-jwt-secret-key-12345
JWT_REFRESH_SECRET=dev-socialconnect-refresh-secret-12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload Limits
MAX_FILE_SIZE_MB=10
MAX_FILES=10

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SocialConnect <noreply@socialconnect.dev>
